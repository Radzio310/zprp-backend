# bastion-connector - zmienne srodowiskowe. Wartosci sekretow ustawia wlasciciel w Railway, nigdy w repo.
BASTION_PORTAL_BASE_URL=https://portal.handball-bastion.pl
# Klucz AES-256 (base64, 32 bajty): python -c "import os,base64;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
BASTION_SECRETS_KEY=
# Poprzednie klucze (po przecinku) - tylko do odczytu przy rotacji; stan jest przepisywany nowym kluczem.
BASTION_SECRETS_KEY_PREVIOUS=
# Token serwer-serwer (backend BAZY -> connector). Losowy, co najmniej 32 znaki.
BASTION_CONNECTOR_TOKEN=
# Sekret podpisu biletow wejscia do widoku logowania (inny niz token). Losowy, co najmniej 32 znaki.
BASTION_TICKET_SECRET=
# Origin-y, z ktorych wolno otworzyc WSS widoku logowania (po przecinku), np. https://bazapodreka.app
BASTION_ALLOWED_ORIGINS=
BASTION_LOGIN_ATTEMPT_TTL_SECONDS=600
BASTION_TICKET_TTL_SECONDS=60
BASTION_MAX_ACTIVE_LOGINS=2
# Sufiksy hostow, z ktorych moze pochodzic embed Bunny (po przecinku). Do potwierdzenia pierwsza proba.
BASTION_EMBED_HOST_SUFFIXES=mediadelivery.net
# Mecz uzywany do weryfikacji sesji (GET /api/game-context). Wymagany do potwierdzenia logowania.
BASTION_PROBE_BUNNY_ITEM_ID=
# Wolumen na zaszyfrowany stan (Railway: wolumen zamontowany w /data). Lokalnie: katalog wskazany tutaj.
BASTION_DATA_DIR=./.data
# Strona testowa /test (techniczna, bez UI docelowego). Domyslnie wylaczona.
BASTION_TEST_PAGE=false
# Tylko lokalnie: Chromium z widocznym oknem.
BASTION_HEADFUL=false
# Tylko lokalnie, gdy nie da sie pobrac przegladarki Playwrighta: sciezka do istniejacego Chromium.
BASTION_CHROMIUM_PATH=
