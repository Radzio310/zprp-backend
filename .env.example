SECRET_KEY=replace-with-your-secret-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
ZPRP_BASE_URL=https://baza.zprp.pl
RSA_PRIVATE_KEY="""-----BEGIN PRIVATE KEY-----[...]"""

# ProEl — oficjalne API baza.zprp.pl (/api/proel/v1/). Klucz zna WYŁĄCZNIE
# serwer; aplikacja chodzi przez proxy /proel/zprp/*.
PROEL_APP_KEY=
# PROEL_ZPRP_BASE_URL=https://baza.zprp.pl/api/proel/v1

# ProEl — konta użytkowników (osobny sekret tokenów; bez fallbacku do
# BEACH_AUTH_SECRET — światy mają się nie mieszać). Puste = fallback SECRET_KEY.
PROEL_AUTH_SECRET=
# PROEL_AUTH_TOKEN_TTL_SECONDS=2592000
# PROEL_EMAIL_FROM_NAME=ProEl — BAZA

# BAZA — serwerowy monitor meczów (15 min lekki, 4 h pełny)
ZPRP_MATCH_MONITOR_ENABLED=true
ZPRP_MATCH_MONITOR_LIGHT_SECONDS=900
ZPRP_MATCH_MONITOR_FULL_SECONDS=14400
ZPRP_MATCH_MONITOR_PROVINCE_CONCURRENCY=2
ZPRP_MATCH_MONITOR_FULL_PROVINCE_CONCURRENCY=1
ZPRP_MATCH_MONITOR_DETAIL_CONCURRENCY=6
ZPRP_MATCH_MONITOR_DETAIL_RETRIES=2

# Publiczna hurtownia rozgrywek ZPRP (bez logowania). Domyślne limity są
# celowo zachowawcze: maks. 3 żądania równolegle i odstęp między startami.
ZPRP_PUBLIC_SYNC_ENABLED=true
ZPRP_PUBLIC_API_CONCURRENCY=3
ZPRP_PUBLIC_API_MIN_INTERVAL=0.18
ZPRP_PUBLIC_API_TIMEOUT=25
ZPRP_PUBLIC_API_RETRIES=2
ZPRP_PUBLIC_START_DELAY_SECONDS=30
ZPRP_PUBLIC_CLUB_BATCH=24
ZPRP_PUBLIC_ROSTER_BATCH=40
ZPRP_PUBLIC_DETAILS_BATCH=60
ZPRP_PUBLIC_RAW_RETENTION_DAYS=90

# BAZA pod RĘKĄ — alarmy techniczne. Uzupełnić wyłącznie w sejfie sekretów hostingu.
POD_REKA_DISCORD_WEBHOOK_URL=
POD_REKA_DISCORD_DEDUP_SECONDS=1800

# BAZA — centralne niedyspozycje wszystkich sędziów okręgu. Te same konta
# ZPRP_SYNC_* logują komisję; snapshot ZPRP odświeża się co 2 godziny.
ZPRP_OFFTIME_SYNC_ENABLED=true
ZPRP_OFFTIME_SYNC_SECONDS=7200
ZPRP_OFFTIME_SYNC_INITIAL_DELAY_SECONDS=120
ZPRP_OFFTIME_SYNC_PROVINCE_CONCURRENCY=2
ZPRP_OFFTIME_SYNC_JUDGE_CONCURRENCY=4
ZPRP_OFFTIME_SYNC_RETRIES=2

# Jednorazowa paczka 5 testowych pushy po wdrożeniu. Pusty klucz = wyłączone.
# Aby powtórzyć test świadomie, ustaw nową, unikalną wartość BATCH_KEY.
PUSH_DEPLOY_TEST_BATCH_KEY=
PUSH_DEPLOY_TEST_JUDGE_ID=5124
PUSH_DEPLOY_TEST_INTERVAL_SECONDS=10
PUSH_DEPLOY_TEST_WAIT_SECONDS=1800

# Ustaw na Railway wyłącznie pary dla obsługiwanych województw. Jeżeli brakuje
# USERNAME albo PASSWORD, to dane województwo jest bezpiecznie pomijane.
ZPRP_SYNC_DOLNOSLASKIE_USERNAME=
ZPRP_SYNC_DOLNOSLASKIE_PASSWORD=
ZPRP_SYNC_KUJAWSKO_POMORSKIE_USERNAME=
ZPRP_SYNC_KUJAWSKO_POMORSKIE_PASSWORD=
ZPRP_SYNC_LUBELSKIE_USERNAME=
ZPRP_SYNC_LUBELSKIE_PASSWORD=
ZPRP_SYNC_LUBUSKIE_USERNAME=
ZPRP_SYNC_LUBUSKIE_PASSWORD=
ZPRP_SYNC_LODZKIE_USERNAME=
ZPRP_SYNC_LODZKIE_PASSWORD=
ZPRP_SYNC_MALOPOLSKIE_USERNAME=
ZPRP_SYNC_MALOPOLSKIE_PASSWORD=
ZPRP_SYNC_MAZOWIECKIE_USERNAME=
ZPRP_SYNC_MAZOWIECKIE_PASSWORD=
ZPRP_SYNC_OPOLSKIE_USERNAME=
ZPRP_SYNC_OPOLSKIE_PASSWORD=
ZPRP_SYNC_PODKARPACKIE_USERNAME=
ZPRP_SYNC_PODKARPACKIE_PASSWORD=
ZPRP_SYNC_PODLASKIE_USERNAME=
ZPRP_SYNC_PODLASKIE_PASSWORD=
ZPRP_SYNC_POMORSKIE_USERNAME=
ZPRP_SYNC_POMORSKIE_PASSWORD=
ZPRP_SYNC_SLASKIE_USERNAME=
ZPRP_SYNC_SLASKIE_PASSWORD=
ZPRP_SYNC_SWIETOKRZYSKIE_USERNAME=
ZPRP_SYNC_SWIETOKRZYSKIE_PASSWORD=
ZPRP_SYNC_WARMINSKO_MAZURSKIE_USERNAME=
ZPRP_SYNC_WARMINSKO_MAZURSKIE_PASSWORD=
ZPRP_SYNC_WIELKOPOLSKIE_USERNAME=
ZPRP_SYNC_WIELKOPOLSKIE_PASSWORD=
ZPRP_SYNC_ZACHODNIOPOMORSKIE_USERNAME=
ZPRP_SYNC_ZACHODNIOPOMORSKIE_PASSWORD=

# Zapisy okregowe (ogloszenia, niedyspozycje): 1 = zadanie BEZ waznego tokenu
# jest odrzucane. Pusto = okres przejsciowy, czyli takie zadanie przechodzi i
# zostawia ostrzezenie w logu - do czasu, gdy wygasna stare wersje aplikacji.
# Patrz app/province_guard.py
PROVINCE_WRITE_STRICT=

# Trasy admina, ktore przedstawiaja sie naglowkami aktora ProEl
# (/admin/extra-report, /admin/training/spk, /proel/users/admin): 1 = numer
# sedziego admina musi byc dowiedziony (X-Admin-Token z JWT BAZY, sesja
# podniesiona albo token konta ProEl). Pusto = okres przejsciowy, czyli takie
# zadanie przechodzi i zostawia ostrzezenie w logu.
# Patrz app/proel_admin_guard.py
PROEL_ADMIN_STRICT=

# Handball Bastion w Mentorze (etap 1, docs/mentor-panel.md sekcja "Handball Bastion").
# BASTION_ENABLED=false (domyslnie) wylacza WSZYSTKO: trasy /mentor-panel/bastion/* odpowiadaja 404
# BASTION_DISABLED, linki do portalu sa zwyklymi linkami, YouTube/Vimeo/uploady dzialaja jak dotad.
# Sesje Bastionu trzyma osobny serwis bastion-connector (bastion_connector/.env.example); tu tylko adres i token.
BASTION_ENABLED=false
BASTION_DEFAULT_ENABLED=true
BASTION_PERSONAL_ENABLED=true
BASTION_PORTAL_BASE_URL=https://portal.handball-bastion.pl
# Adres connectora widziany z backendu (Railway private network albo publiczny HTTPS), bez koncowego "/".
BASTION_CONNECTOR_URL=
# Token serwer-serwer (ten sam co w connectorze). Losowy, >= 32 znaki. NIGDY w kliencie ani w repo.
BASTION_CONNECTOR_TOKEN=
# Adres bazowy WSS widoku logowania widziany z PRZEGLADARKI (np. wss://bastion-connector.up.railway.app).
# Puste = wyprowadzany z BASTION_CONNECTOR_URL. Origin musi byc na liscie BASTION_ALLOWED_ORIGINS connectora.
BASTION_LOGIN_VIEW_BASE_URL=
BASTION_LOGIN_ATTEMPT_TTL_SECONDS=600
BASTION_MAX_ACTIVE_LOGINS=2
# Mecz probny do kontrolnego sprawdzenia polaczenia i weryfikacji logowania (bunny_item_id).
BASTION_PROBE_BUNNY_ITEM_ID=
# Timeout pojedynczego zapytania do connectora (sekundy, 1-30).
BASTION_CONNECTOR_TIMEOUT_S=8
# Etap 4 (kolejka MP4; worker jeszcze nie istnieje):
BASTION_CLIP_WORKERS=1
BASTION_MEDIA_MAX_BYTES=
# Klucz AES-256 stanu sesji - ustawiany WYLACZNIE w serwisie connectora; backend BAZY go nie uzywa.
BASTION_SECRETS_KEY=
